# LLM / embeddings
OPENAI_API_KEY=replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# PostgreSQL metadata database. Required; no SQLite fallback.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Vector provider selected through the VectorStore interface.
VECTOR_PROVIDER=pgvector
# Embeddings are stored in Supabase PostgreSQL using pgvector.
# Security: generate with a password manager; minimum 32 random characters
JWT_SECRET=replace-with-32-plus-random-characters
JWT_ISSUER=rag-chatbot
JWT_AUDIENCE=rag-widget
ADMIN_API_KEY=replace-with-a-long-admin-secret
WIDGET_SESSION_TTL_SECONDS=600
# Context.dev extraction provider
CONTEXT_DEV_API_KEY=replace-with-context-dev-key
CONTEXT_DEV_BASE_URL=https://api.context.dev/v1
CONTEXT_DEV_MAX_PAGES=100
CONTEXT_DEV_ANALYSIS_MAX_LINKS=50
# Optional regex filter, for example /customers/
CONTEXT_DEV_ANALYSIS_URL_REGEX=
CONTEXT_DEV_TIMEOUT=300
# Retrieval
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHAT_RATE_LIMIT=30/minute
WIDGET_VALIDATION_CACHE_TTL_SECONDS=300
ANSWER_CACHE_TTL_SECONDS=300
PUBLIC_BASE_URL=https://yourdomain.com
