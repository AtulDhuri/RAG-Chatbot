# ---- LLM / Embeddings provider (OpenAI) ----
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ---- Crawler ----
# Max number of pages to crawl per domain
CRAWL_MAX_PAGES=100
# Seconds a domain's crawled content stays fresh before a re-crawl is allowed
CRAWL_TTL_SECONDS=86400
# Respect robots.txt (true/false)
CRAWL_RESPECT_ROBOTS=true
# Per-request timeout (seconds)
CRAWL_TIMEOUT=15
# ---- Vector store ----
CHROMA_PERSIST_DIR=./data/chroma
# ---- Retrieval ----
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# ---- Server ----
# Comma-separated list of allowed origins. Use * for prototype (any site can embed).
ALLOWED_ORIGINS=*
# Rate limit for the chat endpoint, e.g. "30/minute"
CHAT_RATE_LIMIT=30/minute
